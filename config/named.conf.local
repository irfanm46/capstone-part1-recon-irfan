// Authoritative Zone Configuration for Lab Environment
zone "lab.local" {
    type master;
    file "/etc/bind/zones/db.lab.local";
    // Intentionally misconfigured to demonstrate AXFR vulnerability (Task 5)
    allow-transfer { any; };
};

zone "56.168.192.in-addr.arpa" {
    type master;
    file "/etc/bind/zones/db.192.168.56";
    allow-transfer { any; };
};
